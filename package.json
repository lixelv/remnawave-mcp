{
  "name": "remnawave-mcp",
  "version": "0.1.0",
  "description": "MCP server for Remnawave panel API",
  "main": "dist/server.js",
  "bin": {
    "remnawave-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
